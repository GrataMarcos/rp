# ─────────────────────────────────────────────────────────────
#  WhatsApp — Meta Cloud API
#  developers.facebook.com → Tu app → WhatsApp → API Setup
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=                    # Token permanente (EAABs...)
WHATSAPP_PHONE_NUMBER_ID=          # ID del número de teléfono
WHATSAPP_VERIFY_TOKEN=             # String secreto que vos elegís
WHATSAPP_API_VERSION=v20.0         # Versión de la API (opcional)

# ─────────────────────────────────────────────────────────────
#  OpenAI
#  platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=                    # sk-proj-...
OPENAI_MODEL=gpt-4o-mini           # Modelo para parseo de gastos

# ─────────────────────────────────────────────────────────────
#  Supabase — Base de datos principal (web app + bot)
#  app.supabase.com → Settings → API
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=              # service_role key (bypasa RLS — solo para Lambda)

# ─────────────────────────────────────────────────────────────
#  DynamoDB — Solo deduplicación de mensajes WhatsApp
#  (las sesiones de conversación ahora usan Supabase)
#  Crear tabla: pk (String PK), con TTL habilitado
# ─────────────────────────────────────────────────────────────
DYNAMODB_TABLE=ExpenseBotData      # Nombre de la tabla (solo para dedup)

# ─────────────────────────────────────────────────────────────
#  Web App (Next.js en Vercel)
#  web/.env.local.example para más variables
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=               # https://tuapp.vercel.app (para links de invitación)

# ─────────────────────────────────────────────────────────────
#  Email — Resend (opcional, para invitaciones por email)
#  resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=                    # re_... (si no está configurado, el link se loguea)

# ─────────────────────────────────────────────────────────────
#  Configuración del bot
# ─────────────────────────────────────────────────────────────
SESSION_TTL_SECONDS=1800           # Expiración de sesión en Supabase (30 min)
DEFAULT_CURRENCY=ARS               # Moneda por defecto
TIMEZONE=America/Argentina/Buenos_Aires
