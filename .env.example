# ─────────────────────────────────────────────────────────────
#  WhatsApp — Meta Cloud API
#  developers.facebook.com → Tu app → WhatsApp → API Setup
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=                    # Token permanente (EAABs...)
WHATSAPP_PHONE_NUMBER_ID=          # ID del número de pruebas
WHATSAPP_VERIFY_TOKEN=             # String secreto que vos elegís
WHATSAPP_API_VERSION=v20.0         # Versión de la API (opcional)

# ─────────────────────────────────────────────────────────────
#  OpenAI
#  platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=                    # sk-proj-...
OPENAI_MODEL=gpt-4o-mini           # Modelo para parseo de gastos

# ─────────────────────────────────────────────────────────────
#  Google Sheets
#  Ver README para crear la cuenta de servicio
# ─────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=             # ID del spreadsheet (de la URL)
GOOGLE_SHEET_NAME=Gastos           # Nombre de la hoja

# Pegá el contenido completo de credentials.json como string JSON
GOOGLE_CREDENTIALS_JSON=           # {"type":"service_account","project_id":"...",...}

# ─────────────────────────────────────────────────────────────
#  DynamoDB — Sesiones y deduplicación
#  Crear la tabla en AWS antes de deploy (ver README)
# ─────────────────────────────────────────────────────────────
DYNAMODB_TABLE=ExpenseBotData      # Nombre de la tabla
SESSION_TTL_SECONDS=1800           # Expiración de sesión (30 min)

# ─────────────────────────────────────────────────────────────
#  Supabase — Base de datos principal (web app + bot)
#  app.supabase.com → Settings → API
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=                      # https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=              # service_role key (bypasa RLS — solo para Lambda)

# ─────────────────────────────────────────────────────────────
#  Configuración del bot
# ─────────────────────────────────────────────────────────────
DEFAULT_CURRENCY=ARS               # Moneda por defecto
TIMEZONE=America/Argentina/Buenos_Aires
