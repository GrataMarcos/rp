# ─────────────────────────────────────────────────────────────
#  WhatsApp — Meta Cloud API
#  https://developers.facebook.com/apps → Tu app → WhatsApp → API Setup
# ─────────────────────────────────────────────────────────────
WHATSAPP_TOKEN=           # Token permanente de la app (EAABs...)
WHATSAPP_PHONE_NUMBER_ID= # ID del número de pruebas (ej. 123456789012345)
WHATSAPP_VERIFY_TOKEN=    # Cualquier string secreto que elijas (ej. mi-bot-secret-2024)

# ─────────────────────────────────────────────────────────────
#  OpenAI — GPT-4o-mini + Whisper
#  https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=           # sk-proj-...
OPENAI_MODEL=gpt-4o-mini  # Modelo para parseo de gastos (gpt-4o-mini es suficiente y barato)

# ─────────────────────────────────────────────────────────────
#  Google Sheets
#  Ver README para crear la cuenta de servicio
# ─────────────────────────────────────────────────────────────
GOOGLE_SPREADSHEET_ID=    # ID del spreadsheet (de la URL: /spreadsheets/d/<ID>/edit)
GOOGLE_SHEET_NAME=Gastos  # Nombre de la hoja dentro del spreadsheet

# Opción A — Archivo local (desarrollo)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Opción B — JSON inline (para deploys en Railway/Render/Heroku, comentar opción A)
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ─────────────────────────────────────────────────────────────
#  Configuración del bot
# ─────────────────────────────────────────────────────────────
PORT=3000
DEFAULT_CURRENCY=ARS          # Moneda por defecto si no se detecta
SESSION_TTL_SECONDS=1800      # Tiempo de expiración de sesión (30 min)
